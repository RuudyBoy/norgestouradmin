+                children: [
+                  const SizedBox(height: 4),
+                  Row(
+                    children: [
+                      const Icon(
+                        Icons.map,
+                        size: 15,
+                        color: AppColors.adminTextSecondary,
+                      ),
+                      const SizedBox(width: 4),
+                      Flexible(
+                        child: Text(
+                          location,
+                          overflow: TextOverflow.ellipsis,
+                          maxLines: 1,
+                        ),
+                      ),
+                      const SizedBox(width: 12),
+                      const Icon(
+                        Icons.calendar_today,
+                        size: 14,
+                        color: AppColors.adminTextSecondary,
+                      ),
+                      const SizedBox(width: 4),
