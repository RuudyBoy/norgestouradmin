rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins have full read/write access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public read for user-facing collections
    match /tournaments/{id} {
      allow read: if true;
    }

    match /categories/{id} {
      allow read: if true;
    }

    match /players/{id} {
      allow read: if true;
    }

    match /teams/{id} {
      allow read: if true;
    }

    match /matches/{id} {
      allow read: if true;
    }

    match /matches/{matchId}/events/{eventId} {
      allow read: if true;
    }
  }
}
